{
  "name": "phonebook",
  "version": "1.0.0",
  "description": "Full Stack Open: Part 3 - Phonebook backend",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:ui": "rm -rf dist && cd ../phonebook-frontend/ && npm run build && cp -r dist ../phonebook-backend",
    "deploy": "fly deploy --ha=false",
    "deploy:full": "npm run build:ui && npm run deploy",
    "logs:prod": "fly logs",
    "fly:stop": "fly scale count 0",
    "fly:start": "fly scale count 1",
    "lint": "eslint ."
  },
  "author": "Dan Anderson",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "mongoose": "^8.14.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@flydotio/dockerfile": "^0.7.10",
    "@stylistic/eslint-plugin-js": "^4.2.0",
    "eslint": "^9.26.0",
    "globals": "^16.1.0"
  }
}
